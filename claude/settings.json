{
  "alwaysThinkingEnabled" : true,
  "attribution" : {
    "commit" : "",
    "pr" : "",
    "sessionUrl" : false
  },
  "enabledPlugins" : {
    "chrome-devtools-mcp@claude-plugins-official" : true,
    "cloudflare@claude-plugins-official" : true,
    "code-review@claude-plugins-official" : true,
    "code-simplifier@claude-plugins-official" : true,
    "frontend-design@claude-plugins-official" : true,
    "notion@anthropic-plugin-directory" : true,
    "playground@claude-plugins-official" : true,
    "pyright-lsp@claude-plugins-official" : true,
    "remember@claude-plugins-official" : true,
    "security-guidance@claude-plugins-official" : true,
    "skill-creator@claude-plugins-official" : true,
    "swift-lsp@claude-plugins-official" : true,
    "typescript-lsp@claude-plugins-official" : true
  },
  "env" : {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE" : "75",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC" : "1",
    "CLAUDE_CODE_SCROLL_SPEED" : "3",
    "CLAUDE_CODE_SUBAGENT_MODEL" : "sonnet",
    "DISABLE_ERROR_REPORTING" : "1",
    "DISABLE_TELEMETRY" : "1"
  },
  "extraKnownMarketplaces" : {
    "airas" : {
      "source" : {
        "repo" : "airas-org\/airas",
        "source" : "github"
      }
    }
  },
  "hooks" : {
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "command" : "bash '~\/.claude\/hooks\/herdr-agent-state.sh' session || true",
            "timeout" : 10,
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "[ -n \"$TTY\" ] && [ -c \"$TTY\" ] && printf '\\a' > \"$TTY\" || true",
            "type" : "command"
          }
        ],
        "matcher" : ""
      },
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "\"\/Users\/kmuto\/.config\/iterm2\/it2\" handle-agent-hook",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "language" : "japanese",
  "modelSettings" : {
    "claude-opus-5-5" : {
      "effortLevel" : "medium"
    }
  },
  "outputStyle" : "Explanatory",
  "permissions" : {
    "allow" : [
      "Bash(make:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(gemini:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(lsof:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(test:*)",
      "Bash(du:*)",
      "Bash(grep:*)",
      "Bash(\/usr\/bin\/du:*)",
      "Bash(\/usr\/bin\/grep:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx husky:*)",
      "Bash(poetry run python test:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(pre-commit run:*)",
      "Bash(git checkout:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(ipconfig getifaddr:*)",
      "Bash(mise list:*)",
      "Bash(flutter run:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter build:*)",
      "Bash(codex exec:*)",
      "Edit(.\/src\/**)",
      "Edit(~\/.npm\/**)",
      "Edit(~\/.cache\/**)",
      "Edit(\/\/tmp\/**)",
      "Skill(codex)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__serena",
      "mcp__codex__codex",
      "mcp__chrome-devtools",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__close_page",
      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__fill",
      "mcp__chrome-devtools__wait_for",
      "mcp__chrome-devtools__evaluate_script"
    ],
    "defaultMode" : "acceptEdits",
    "deny" : [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(.\/.env)",
      "Read(.\/credentials\/**)",
      "Read(*credentials*)",
      "Read(.\/secrets\/**)",
      "Read(.\/.dev.vars)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~\/.ssh\/**)",
      "Read(~\/.aws\/**)",
      "Bash(gh issue delete:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh repo delete:*)"
    ]
  },
  "pluginConfigs" : {
    "agents-md@builtin" : {
      "options" : {
        "instructionFiles" : "claude-md-and-agents-md"
      }
    }
  },
  "sandbox" : {
    "allowUnsandboxedCommands" : false,
    "autoAllowBashIfSandboxed" : true,
    "credentials" : {
      "envVars" : [
        {
          "mode" : "deny",
          "name" : "GITHUB_TOKEN"
        },
        {
          "mode" : "deny",
          "name" : "OPENAI_API_KEY"
        },
        {
          "mode" : "deny",
          "name" : "GEMINI_API_KEY"
        },
        {
          "mode" : "deny",
          "name" : "ANTHROPIC_API_KEY"
        },
        {
          "mode" : "deny",
          "name" : "CLAUDE_CODE_OAUTH_TOKEN"
        }
      ],
      "files" : [
        {
          "mode" : "deny",
          "path" : "~\/.ssh"
        },
        {
          "mode" : "deny",
          "path" : "~\/.aws\/credentials"
        },
        {
          "mode" : "deny",
          "path" : "~\/.config\/gcloud"
        },
        {
          "mode" : "deny",
          "path" : "~\/.kube\/config"
        }
      ]
    },
    "enabled" : true,
    "failIfUnavailable" : false,
    "filesystem" : {
      "denyRead" : [
        ".\/.env",
        ".\/credentials\/**",
        ".\/*credentials*",
        ".\/secrets\/**",
        "**\/*.pem",
        "**\/*.key",
        "~\/.ssh",
        "~\/.aws"
      ]
    }
  },
  "statusLine" : {
    "command" : "~\/.claude\/statusline.sh",
    "type" : "command"
  },
  "theme" : "dark",
  "tui" : "fullscreen"
}